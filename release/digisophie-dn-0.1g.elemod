{
 "elemod": 2,
 "id": "digisophie-dn",
 "version": "0.1g",
 "title": "SOPHIE (Digitone machine)",
 "description": "SOPHIE metallic percussion (FUSE/BOOM/PIPE/SHARD) as a Digitone mk1 machine: OCT, MODEL, FOLD, SWEEP, METAL, FBK, COLOR on borrowed stock SYN ranges (no custom params), newest-wins per track, through the Digitone filter/mixer/AMP. Needs the machines mod and core-dn1 3.1. Port of soejrd/digisophie (Digitakt) to Digitone.",
 "category": "Sound",
 "author": "digisophie contributors",
 "license": "MIT",
 "target": {
  "device": "digitone-mk1",
  "product": "Digitone mk1",
  "os": "1.43",
